# CrossMarket backend configuration. Copy to `.env` (loaded by your shell or a
# process manager) — all values are optional and have sensible defaults.

# Port the REST API listens on.
PORT=8787

# How often (ms) to re-poll venues and rebuild the canonical graph.
REFRESH_MS=60000

# OPTIONAL: enable the LLM-backed market matcher (PRD §14). When set, candidate
# pairs are classified by Claude instead of the deterministic heuristic. Leave
# unset to run fully offline with the heuristic classifier.
# ANTHROPIC_API_KEY=sk-ant-...
